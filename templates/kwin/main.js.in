const RULES = __RULES__;
const OUTPUT_ROLES = __OUTPUTS__;

const placedWindows = [];
const placedActivities = [];
const watchedWindows = [];

function windowKey(win) {
    return String(win.internalId);
}

function outputByName(name) {
    const screens = workspace.screens;
    for (let i = 0; i < screens.length; i++) {
        if (screens[i].name === name) return screens[i];
    }
    return null;
}

function areaFor(output) {
    return workspace.clientArea(KWin.MaximizeArea, output, workspace.currentDesktop);
}

function currentActivityMatches(rule) {
    return !rule.activity || workspace.currentActivity === rule.activity;
}

function visibleInCurrentActivity(win) {
    const activities = win.activities;
    if (!activities || activities.length === 0) return true;
    return activities.indexOf(workspace.currentActivity) >= 0;
}

function matchingRule(win) {
    const cls = (win.resourceClass || "").toLowerCase();
    const title = (win.caption || "").toLowerCase();
    for (let i = 0; i < RULES.length; i++) {
        const rule = RULES[i];
        if (!rule.wm_class && !rule.match_title) continue;
        if (!currentActivityMatches(rule)) continue;
        if (rule.wm_class && rule.wm_class !== cls) continue;
        if (rule.match_title && title.indexOf(rule.match_title) < 0) continue;
        return rule;
    }
    return null;
}

function alreadyPlaced(win) {
    const key = windowKey(win);
    for (let i = 0; i < placedWindows.length; i++) {
        if (placedWindows[i] === key) {
            return placedActivities[i] === workspace.currentActivity;
        }
    }
    return false;
}

function markPlaced(win) {
    const key = windowKey(win);
    for (let i = 0; i < placedWindows.length; i++) {
        if (placedWindows[i] === key) {
            placedActivities[i] = workspace.currentActivity;
            return;
        }
    }
    placedWindows.push(key);
    placedActivities.push(workspace.currentActivity);
}

function forget(win) {
    const key = windowKey(win);
    let index = placedWindows.indexOf(key);
    if (index >= 0) {
        placedWindows.splice(index, 1);
        placedActivities.splice(index, 1);
    }
    index = watchedWindows.indexOf(key);
    if (index >= 0) watchedWindows.splice(index, 1);
}

function place(win, rule) {
    const output = outputByName(rule.output);
    if (!output) return false;
    const area = areaFor(output);
    const gap = rule.zone.gap_px || 0;
    const x = Math.round(area.x + area.width * rule.zone.x + gap);
    const y = Math.round(area.y + area.height * rule.zone.y + gap);
    const w = Math.max(200, Math.round(area.width * rule.zone.w - gap * 2));
    const h = Math.max(200, Math.round(area.height * rule.zone.h - gap * 2));

    if (win.fullScreen) win.fullScreen = false;
    win.setMaximize(false, false);
    workspace.sendClientToScreen(win, output);
    win.frameGeometry = { x: x, y: y, width: w, height: h };
    if (rule.mode === "maximized") {
        win.setMaximize(true, true);
    } else if (rule.mode === "fullscreen") {
        win.fullScreen = true;
    }
    return true;
}

function watchFullscreen(win) {
    if (!win) return;
    const key = windowKey(win);
    if (watchedWindows.indexOf(key) >= 0) return;
    watchedWindows.push(key);
    win.fullScreenChanged.connect(updateFullscreen);
}

function applyRule(win) {
    if (!win || !win.normalWindow || alreadyPlaced(win)) return;
    if (!visibleInCurrentActivity(win)) return;
    const rule = matchingRule(win);
    if (!rule) return;
    if (place(win, rule)) {
        markPlaced(win);
        watchFullscreen(win);
        updateFullscreen();
    }
}

let fullscreenOutput = "";

function updateFullscreen() {
    const win = workspace.activeWindow;
    const isFullscreen = !!(win && win.fullScreen && win.output);
    const outputName = isFullscreen ? win.output.name : "";
    if (fullscreenOutput && fullscreenOutput !== outputName) {
        callDBus("org.rice.Rice", "/Rice", "org.rice.Rice", "SetFullscreen",
                 fullscreenOutput, false);
    }
    if (outputName) {
        callDBus("org.rice.Rice", "/Rice", "org.rice.Rice", "SetFullscreen",
                 outputName, isFullscreen);
    }
    fullscreenOutput = outputName;
}

function applyAll() {
    const windows = workspace.windowList();
    for (let i = 0; i < windows.length; i++) applyRule(windows[i]);
}

workspace.windowAdded.connect(applyRule);
workspace.windowRemoved.connect(forget);
workspace.windowActivated.connect(function (win) {
    applyRule(win);
    watchFullscreen(win);
    updateFullscreen();
});
workspace.currentActivityChanged.connect(function () {
    applyAll();
    updateFullscreen();
});

applyAll();
updateFullscreen();

// --- Shortcut dispatcher -------------------------------------------------
// Shortcut bindings resolve output connectors from OUTPUT_ROLES at runtime so
// the generated script never contains a hard-coded connector name. Daemon
// actions are forwarded to the org.rice.Rice session service.

function connectorForRole(role) {
    for (let i = 0; i < OUTPUT_ROLES.length; i++) {
        if (OUTPUT_ROLES[i].role === role) return OUTPUT_ROLES[i].connector;
    }
    return null;
}

function activeWindow() {
    return workspace.activeWindow;
}

function toggleMaximizeActive() {
    const win = activeWindow();
    if (!win) return;
    const both = win.maximizeMode === 3;
    win.setMaximize(!both, !both);
}

function minimizeActive() {
    const win = activeWindow();
    if (win) win.minimized = true;
}

function closeActive() {
    const win = activeWindow();
    if (win) win.close();
}

function moveActiveToOutput(connector) {
    const win = activeWindow();
    const output = connector ? outputByName(connector) : null;
    if (win && output) {
        workspace.sendClientToScreen(win, output);
    }
}

function moveActiveToRole(role) {
    moveActiveToOutput(connectorForRole(role));
}

function cycleWindowsOnOutput(step) {
    const win = activeWindow();
    if (!win || !win.output) return;

    const outputName = win.output.name;
    const activity = workspace.currentActivity;
    const windows = [];
    const all = workspace.windowList();
    for (let i = 0; i < all.length; i++) {
        const candidate = all[i];
        if (!candidate.normalWindow || !candidate.output || candidate.output.name !== outputName) {
            continue;
        }
        const activities = candidate.activities || [];
        if (activities.length > 0 && activities.indexOf(activity) < 0) {
            continue;
        }
        windows.push(candidate);
    }
    if (windows.length < 2) return;

    let index = windows.indexOf(win);
    if (index < 0) index = 0;
    index = (index + step + windows.length) % windows.length;
    const target = windows[index];
    if (target.minimized) target.minimized = false;
    workspace.activeWindow = target;
}

function tileActiveWindow(side) {
    const win = activeWindow();
    if (!win || !win.output) return;
    const zone = side === "left"
        ? { x: 0, y: 0, w: 0.5, h: 1, gap_px: 0 }
        : { x: 0.5, y: 0, w: 0.5, h: 1, gap_px: 0 };
    place(win, { output: win.output.name, zone: zone, mode: "normal" });
}

function callRice(method) {
    callDBus("org.rice.Rice", "/Rice", "org.rice.Rice", method);
}

function callRiceArg(method, arg) {
    callDBus("org.rice.Rice", "/Rice", "org.rice.Rice", method, arg);
}

registerShortcut("Rice: Maximize active window", "Rice: Maximize active window", "Meta+M", function() {
    toggleMaximizeActive();
});

registerShortcut("Rice: Minimize active window", "Rice: Minimize active window", "Meta+N", function() {
    minimizeActive();
});

registerShortcut("Rice: Close active window", "Rice: Close active window", "Meta+Q", function() {
    closeActive();
});

registerShortcut("Rice: Tile active left", "Rice: Tile active left", "Meta+H", function() {
    tileActiveWindow("left");
});

registerShortcut("Rice: Tile active right", "Rice: Tile active right", "Meta+J", function() {
    tileActiveWindow("right");
});

registerShortcut("Rice: Next window on this display", "Rice: Next window on this display", "Meta+Right", function() {
    cycleWindowsOnOutput(1);
});

registerShortcut("Rice: Previous window on this display", "Rice: Previous window on this display", "Meta+Left", function() {
    cycleWindowsOnOutput(-1);
});

registerShortcut("Rice: Move window to main", "Rice: Move window to main", "Meta+1", function() {
    moveActiveToRole("main");
});

registerShortcut("Rice: Move window to side", "Rice: Move window to side", "Meta+2", function() {
    moveActiveToRole("side");
});

registerShortcut("Rice: Move window to portrait", "Rice: Move window to portrait", "Meta+3", function() {
    moveActiveToRole("portrait");
});

registerShortcut("Rice: Open terminal", "Rice: Open terminal", "Meta+Return", function() {
    callRice("OpenTerminal");
});

registerShortcut("Rice: Open animated terminal", "Rice: Open animated terminal", "Meta+Shift+Return", function() {
    callRice("OpenAnimatedTerminal");
});

registerShortcut("Rice: Cheat sheet", "Rice: Cheat sheet", "Ctrl+Alt+H", function() {
    callRice("ToggleCheatSheet");
});

registerShortcut("Rice: Next theme", "Rice: Next theme", "Ctrl+Alt+Shift+Right", function() {
    callRice("ThemeNext");
});

registerShortcut("Rice: Previous theme", "Rice: Previous theme", "Ctrl+Alt+Shift+Left", function() {
    callRice("ThemePrevious");
});

registerShortcut("Rice: Work activity", "Rice: Work activity", "Ctrl+Alt+1", function() {
    callRiceArg("SwitchActivity", "work");
});

registerShortcut("Rice: Private activity", "Rice: Private activity", "Ctrl+Alt+2", function() {
    callRiceArg("SwitchActivity", "private");
});

registerShortcut("Rice: Quickstart work", "Rice: Quickstart work", "Ctrl+Alt+Shift+1", function() {
    callRice("QuickstartWork");
});

registerShortcut("Rice: Quickstart private", "Rice: Quickstart private", "Ctrl+Alt+Shift+2", function() {
    callRice("QuickstartPrivate");
});

registerShortcut("Rice: Quickstart current activity", "Rice: Quickstart current activity", "Ctrl+Alt+Shift+Space", function() {
    callRice("QuickstartCurrent");
});

registerShortcut("Rice: Reapply window layout", "Rice: Reapply window layout", "Ctrl+Alt+R", function() {
    callRice("ReapplyPlacement");
});
